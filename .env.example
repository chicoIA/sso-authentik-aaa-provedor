# .env.example GERADO por ./provedor exemplo a partir de apps/*/env.example (não edite aqui).
# O .env real é criado por: sudo ./provedor preparar  (gera segredos; nunca faça commit do .env)
# "<gerar>" = segredo aleatório gerado pelo orquestrador; "<token>" = preenchido por ./provedor tokens.

# ==================== apps/authentik/env.example ====================
# ---------- app authentik (núcleo) ----------
AUTHENTIK_TAG=2026.8.3
# Se o ghcr.io estiver bloqueado, use o Docker Hub:
#AUTHENTIK_IMAGE=docker.io/authentik/server
PG_DB=authentik
PG_USER=authentik
PG_PASS=<gerar>
AUTHENTIK_SECRET_KEY=<gerar>
AUTHENTIK_ERROR_REPORTING__ENABLED=false
# Usuário inicial "akadmin" e token de API usado pelos scripts.
AUTHENTIK_BOOTSTRAP_PASSWORD=<gerar>
AUTHENTIK_BOOTSTRAP_TOKEN=<gerar>
AUTHENTIK_BOOTSTRAP_EMAIL=noc@exemplo.net.br
# Endereço pelo qual a equipe acessa o authentik.
AUTHENTIK_URL_EXTERNA=https://100.66.80.196:9443
# Portas no host (o Docker ignora o ufw: prenda a um IP se precisar).
COMPOSE_PORT_HTTP=9000
COMPOSE_PORT_HTTPS=9443
# Consumo (valores baixos por padrão)
#AUTHENTIK_WEB__WORKERS=1
#AUTHENTIK_WEB__THREADS=2
#AUTHENTIK_WORKER__PROCESSES=1
#AUTHENTIK_WORKER__THREADS=2
# Tokens dos outposts: preenchidos por apps/authentik/scripts/tokens_outpost.py --gravar
AUTHENTIK_RADIUS_TOKEN=<token>
AUTHENTIK_LDAP_TOKEN=<token>

# ==================== apps/radius/env.example ====================
# ---------- app radius ----------
# Segredo compartilhado FreeRADIUS <-> outpost. O app authentik precisa repassá-lo
# ao container worker (o blueprint lê com !Env) e o app freeradius usa o mesmo valor.
AUTHENTIK_RADIUS_SECRET=<gerar>
# Token do outpost "provedor-radius" (preenchido por script depois do blueprint aplicado).
# (já definida acima) AUTHENTIK_RADIUS_TOKEN=<token>
# Opcional: redes que podem falar com o outpost (padrão: pontes Docker + loopback).
#AUTHENTIK_RADIUS_CLIENT_NETWORKS=10.233.0.0/16,127.0.0.1/32

# ==================== apps/ldap/env.example ====================
# ---------- app ldap ----------
# Senha da conta de serviço ldap-servico (o worker do authentik também precisa
# recebê-la: o blueprint lê com !Env). Bind DN:
# cn=ldap-servico,ou=users,dc=ldap,dc=provedor,dc=com,dc=br
LDAP_SERVICO_SENHA=<gerar>
# Token do outpost "provedor-ldap" (preenchido por script depois do blueprint aplicado).
# (já definida acima) AUTHENTIK_LDAP_TOKEN=<token>
# Opcional: base DN do diretório (padrão abaixo; mudar exige ajustar quem consome).
#AUTHENTIK_LDAP_BASE_DN=dc=ldap,dc=provedor,dc=com,dc=br

# ==================== apps/freeradius/env.example ====================
# ---------- app freeradius ----------
# (usa também AUTHENTIK_RADIUS_SECRET, definido no env.example do app radius,
#  e OUTPOST_RADIUS_PORTA, opcional: porta do outpost no host, padrão 18120)

# Segredo do cliente "localhost" (healthcheck e testes com radclient). Não é segredo de NAS.
FR_SEGREDO_LOCAL=<gerar>

# Portas RADIUS. 11812/11813 = teste, ao lado do FreeRADIUS do sistema.
# 1812/1813 = depois da virada (apps/freeradius/virada.sh altera estes valores).
FR_PORTA_AUTH=11812
FR_PORTA_ACCT=11813

# Banco do daloRADIUS (socket /run/mysqld, usuário radius@localhost). Somente leitura
# enquanto FR_GRAVAR_SQL=nao. Use os mesmos valores do FreeRADIUS atual.
DALO_DB_USER=radius
DALO_DB_PASS=<senha do usuário radius do MariaDB>
DALO_DB_NAME=radius

# Cache de Access-Accept do authentik, em segundos (rajadas do zabbix). Desativar um
# usuário ou trocar a senha no authentik vale em até este tempo (ou reiniciando o container).
FR_CACHE_TTL=300

# sim = CHAP/MS-CHAP/EAP-MD5 ainda autenticam pelo SQL do daloRADIUS (ambiente não cai);
# nao = recusa (o authentik só aceita PAP). Os dois modos registram quem usa CHAP.
FR_CHAP_LEGADO=sim

# nao = accounting e post-auth só em log (teste). sim = grava radacct e radpostauth (produção,
# definido pela virada). Nunca grava a senha.
FR_GRAVAR_SQL=nao

# no = não exige Message-Authenticator dos equipamentos (como o FreeRADIUS 3.2.1 de hoje).
# yes = exige (BlastRADIUS); só use depois de conferir que todos os NAS enviam.
FR_EXIGIR_MSGAUTH=no

# ==================== apps/migracao/env.example ====================
# App migracao (ferramenta daloRADIUS -> authentik). Só lê o banco radius.
# Já existentes no .env raiz (usados também por este app):
#   DALO_DB_USER / DALO_DB_PASS / DALO_DB_NAME  credenciais do banco radius (somente SELECT)
#   AUTHENTIK_BOOTSTRAP_TOKEN                   token admin para a API do authentik
#   AUTHENTIK_RADIUS_SECRET                     segredo do outpost (verificar --radius)

# Socket do MariaDB do sistema (montado somente leitura no container)
DALO_DB_SOCKET=/run/mysqld/mysqld.sock
# Só se não usar o socket (rede do host):
# DALO_DB_HOST=127.0.0.1
# DALO_DB_PORT=3306

# URL da API vista pelo container (network_mode host)
MIGRACAO_API_URL=http://127.0.0.1:9000
# Outpost RADIUS publicado no host (verificar --radius)
MIGRACAO_RADIUS_ALVO=127.0.0.1:18120

# ==================== apps/backup/env.example ====================
# Variáveis do app backup (todas opcionais)
# Destino das cópias
BACKUP_DIR=/var/backups/provedor
# Dias de retenção
BACKUP_RETENCAO_DIAS=14
# sim = inclui radacct/radpostauth (pesado: 18 GB)
BACKUP_RADACCT=nao
# sim = inclui a tabela nas (contém segredos dos equipamentos; arquivo 600). Padrão: não copia
BACKUP_NAS=nao

# ==================== apps/banco/env.example ====================
# ---------- apps/banco: retenção do radacct/radpostauth ----------
# Dias de histórico mantidos no banco do daloRADIUS (o resto fica nos backups).
BANCO_RETENCAO_DIAS=180

# ==================== apps/tacacs/env.example ====================
# ---------- app tacacs ----------
# Chave TACACS+ compartilhada com os equipamentos (aaa/tacacs-server ... key).
# O orquestrador gera aleatoriamente; só letras, números e . _ ~ + = @ % ^ - ,
# com no mínimo 8 caracteres. Trocar exige reiniciar o app e atualizar os equipamentos.
TACACS_KEY=<gerar>
# O container também usa LDAP_SERVICO_SENHA (definida no app ldap) e, se existir,
# AUTHENTIK_LDAP_BASE_DN (padrão dc=ldap,dc=provedor,dc=com,dc=br).
# Opcional: outro endereço LDAP (padrão: o outpost interno).
#TACACS_LDAP_URL=ldap://ldap-outpost:3389

# ==================== apps/painel/env.example ====================
# ---------- app painel ----------
# Segredo do client OIDC "painel-tacacs" no authentik (o blueprint 05-painel.yaml lê
# esta mesma variável no container authentik-worker, que aplica os blueprints).
PAINEL_OIDC_SECRET=<gerar>
# Chave que assina o cookie de sessão do painel. Trocar derruba as sessões abertas.
PAINEL_SECRET_KEY=<gerar>
# URL pela qual os navegadores acessam o painel (vira o redirect do OIDC).
#PAINEL_URL_EXTERNA=http://100.66.80.196:9049
# O authentik usa certificado autoassinado no 9443: 0 = não verificar TLS (padrão), 1 = verificar.
#PAINEL_OIDC_VERIFICAR_TLS=0
# Dias de retenção dos eventos no SQLite do painel.
#PAINEL_RETENCAO_DIAS=365
# Endereço que o CONTAINER usa para falar com o authentik (troca do código e userinfo).
# Vazio = usa AUTHENTIK_URL_EXTERNA (IP do host). Alternativa: http://authentik-server:9000
#PAINEL_AUTHENTIK_INTERNO=
# Usa também AUTHENTIK_URL_EXTERNA (definida no app authentik) e TZ (padrão America/Sao_Paulo).
