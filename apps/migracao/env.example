# App migracao (ferramenta daloRADIUS -> authentik). Só lê o banco radius.
# Já existentes no .env raiz (usados também por este app):
#   DALO_DB_USER / DALO_DB_PASS / DALO_DB_NAME  credenciais do banco radius (somente SELECT)
#   AUTHENTIK_BOOTSTRAP_TOKEN                   token admin para a API do authentik
#   AUTHENTIK_RADIUS_SECRET                     segredo do outpost (verificar --radius)

# Socket do MariaDB do sistema (montado somente leitura no container)
DALO_DB_SOCKET=/run/mysqld/mysqld.sock
# Só se não usar o socket (rede do host):
# DALO_DB_HOST=127.0.0.1
# DALO_DB_PORT=3306

# URL da API vista pelo container (network_mode host)
MIGRACAO_API_URL=http://127.0.0.1:9000
# Outpost RADIUS publicado no host (verificar --radius)
MIGRACAO_RADIUS_ALVO=127.0.0.1:18120
