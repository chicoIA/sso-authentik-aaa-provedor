# ---------- app ldap ----------
# Senha da conta de serviço ldap-servico (o worker do authentik também precisa
# recebê-la: o blueprint lê com !Env). Bind DN:
# cn=ldap-servico,ou=users,dc=ldap,dc=provedor,dc=com,dc=br
LDAP_SERVICO_SENHA=<gerar>
# Token do outpost "provedor-ldap" (preenchido por script depois do blueprint aplicado).
AUTHENTIK_LDAP_TOKEN=<token>
# Opcional: base DN do diretório (padrão abaixo; mudar exige ajustar quem consome).
#AUTHENTIK_LDAP_BASE_DN=dc=ldap,dc=provedor,dc=com,dc=br
