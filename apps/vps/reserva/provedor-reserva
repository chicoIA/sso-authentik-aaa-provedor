#!/bin/bash
# Reserva do RADIUS/SSO na VPS. Fonte: apps/vps/reserva/ no git.
#
#   provedor-reserva estado        mostra o estado e as sondas
#   provedor-reserva ativa         promove o Postgres e assume o .196 (manual)
#   provedor-reserva volta         devolve para a VM e refaz a réplica
#   provedor-reserva vigia         laço do serviço provedor-reserva-vigia
#
# Ativação automática: o vigia chama "ativa" se a VM não responder RADIUS
# (Status-Server no .196 e no 172.16.7.10) por ESPERA segundos seguidos
# (padrão 300), a VPS tiver ao menos uma sessão BGP de pé e existir o arquivo
# /etc/provedor-reserva/automatico. Sem esse arquivo o vigia só avisa.
#
# O anúncio do .196 é a interface radius0: o FRR redistribui a rota conectada
# (route-map SAIDA, com AS-path mais longo) e as bordas instalam com distância
# 250. Por isso a radius0 só é criada depois que a pilha respondeu, e o vigia a
# derruba se o FreeRADIUS local parar.
#
# A volta é sempre manual: o tráfego volta sozinho para a VM quando ela
# anuncia de novo; este script só arruma a VPS (contabilidade, réplica, Caddy).
set -uo pipefail

DIR=/opt/provedor-reserva
EST=/var/lib/provedor-reserva
CONF=/etc/provedor-reserva
AUTO=$CONF/automatico
ALERTA=$CONF/alerta                 # opcional: executável que recebe a mensagem
SNIP=/var/lib/docker/volumes/proxy_caddy_data/_data/provedor/sso-destino.caddy
SONDA=/usr/local/sbin/provedor-radius-sonda
IP=100.66.80.196
VM=172.16.7.10
ESPERA=${PROVEDOR_RESERVA_ESPERA:-300}
ID_ACCT=1000000000                   # ids de radacct/radpostauth gravados na reserva
P=provedor-reserva-reserva
ATENDIMENTO="reserva-authentik-server reserva-authentik-worker reserva-radius-outpost reserva-freeradius"

# No terminal também mostra; no serviço só o syslog (senão sai duplicado no journal).
log() { logger -t provedor-reserva -- "$*"; [ -t 1 ] && echo "$(date '+%F %T') $*"; return 0; }
alerta() {
    log "ALERTA: $*"
    if [ -x "$ALERTA" ]; then timeout 30 "$ALERTA" "$*" >/dev/null 2>&1 || log "aviso: $ALERTA falhou"; fi
}
estado() { cat "$EST/estado" 2>/dev/null || echo espera; }

# Estado para o Zabbix (SNMP extend, ver provedor-reserva-snmp). Códigos:
#   0 normal (VM responde, réplica em streaming)
#   1 VM sem resposta RADIUS (contando a espera)
#   2 ativando   3 RESERVA ATIVA (VPS atende o .196)
#   4 reserva ativa e a VM responde de novo: rodar "provedor-reserva volta"
#   5 falhou     6 voltando / sem réplica      7 réplica fora de streaming
#   8 VM sem resposta, mas automático desligado ou VPS sem BGP (ação manual)
#   9 vigia parado (calculado pelo provedor-reserva-snmp: arquivo velho)
zbx() {
    mkdir -p "$EST"
    printf '%s %s %s\n' "$1" "$(date +%s)" "$2" > "$EST/zabbix.tmp" && chmod 644 "$EST/zabbix.tmp" && mv "$EST/zabbix.tmp" "$EST/zabbix"
}
poe_estado() { mkdir -p "$EST"; echo "$1" > "$EST/estado.tmp" && mv "$EST/estado.tmp" "$EST/estado"; }
dc() { (cd "$DIR" && docker compose --env-file .env "$@"); }
env_v() { grep -m1 "^$1=" "$DIR/.env" | cut -d= -f2-; }
sql() { docker exec -i "$P-mariadb-1" sh -c 'exec mariadb -uroot -p"$MARIADB_ROOT_PASSWORD" "$@"' -- "$@"; }
psql_r() { docker exec "$P-postgres-1" psql -U authentik -d authentik -Atc "$1"; }

# Segredo do cliente 172.16.0.0/12 (a VPS fala com a VM como NAS): lido da
# cópia da tabela nas que a VM manda a cada 5 min.
segredo_vm() { sql radius -N -e "select secret from nas where nasname='172.16.0.0/12'" 2>/dev/null; }

sonda() {  # sonda <ip> <segredo> [porta]
    SONDA_SEGREDO="$2" SONDA_TEMPO=3 "$SONDA" "$1" "${3:-1812}" status >/dev/null 2>&1
}
vm_responde() {  # 0 se o FreeRADIUS da VM responde em algum dos endereços
    local s; s=$(segredo_vm); [ -n "$s" ] || return 2
    sonda "$VM" "$s" && return 0
    [ -e /sys/class/net/radius0 ] && return 1     # o .196 é local: só o .10 vale
    sonda "$IP" "$s"
}
local_responde() { sonda 127.0.0.1 "$(env_v FR_SEGREDO_LOCAL)" 1812; }
bgp_sessoes() {
    vtysh -c "show bgp ipv4 unicast summary" 2>/dev/null |
        awk '$1 ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ && $10 ~ /^[0-9]+$/ {n++} END {print n+0}'
}

caddy_destino() {  # caddy_destino vm|reserva
    local tmp; tmp=$(mktemp)
    if [ "$1" = reserva ]; then
        cat > "$tmp" <<'EOF'
# RESERVA ATIVA (provedor-reserva): authentik da VPS. Administração congelada:
# o banco da reserva é descartado na volta, alterações feitas aqui se perdem.
respond /if/admin/* "Reserva ativa: administração congelada até a volta da VM." 503
reverse_proxy https://reserva-authentik-server:9443 {
    transport http {
        tls_insecure_skip_verify
    }
}
EOF
    else
        cat > "$tmp" <<'EOF'
# Normal: authentik da VM pelo IP da /30 (não pelo .196, que existe na própria
# VPS quando a reserva está ativa). Trocado por provedor-reserva ativa/volta.
reverse_proxy https://172.16.7.10:9443 {
    transport http {
        tls_insecure_skip_verify
    }
    health_uri /-/health/live/
    health_interval 15s
}
EOF
    fi
    if cmp -s "$tmp" "$SNIP"; then rm -f "$tmp"; return 0; fi
    cp -a "$SNIP" "$SNIP.anterior" 2>/dev/null || true
    cat "$tmp" > "$SNIP"; rm -f "$tmp"
    if docker exec proxy-caddy-1 caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile >/dev/null 2>&1; then
        log "Caddy: sso. -> $1"
    else
        log "ERRO: reload do Caddy falhou; voltando o destino anterior"
        cat "$SNIP.anterior" > "$SNIP"
        docker exec proxy-caddy-1 caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile >/dev/null 2>&1
        return 1
    fi
}

radius0_sobe() {
    ip link add radius0 type dummy 2>/dev/null || true
    ip addr replace "$IP/32" dev radius0
    ip link set radius0 up
}

cmd_estado() {
    local s
    echo "estado: $(estado)   automático: $([ -e "$AUTO" ] && echo ligado || echo desligado)   espera: ${ESPERA}s"
    echo "radius0: $(ip -br addr show radius0 2>/dev/null || echo 'não existe (sem anúncio)')"
    echo "BGP de pé: $(bgp_sessoes)"
    if vm_responde; then echo "VM: responde"; else echo "VM: NÃO responde"; fi
    if [ "$(estado)" != espera ]; then
        if local_responde; then echo "FreeRADIUS local: responde"; else echo "FreeRADIUS local: NÃO responde"; fi
    fi
    echo "Postgres da reserva: $(psql_r "select case when pg_is_in_recovery() then 'réplica' else 'PROMOVIDO' end" 2>/dev/null)" \
         "$(psql_r "select status from pg_stat_wal_receiver" 2>/dev/null)"
    echo "Caddy sso.: $(grep -m1 -o 'reverse_proxy [^ ]*' "$SNIP" 2>/dev/null)"
    dc --profile ativa ps --format '{{.Service}} {{.Status}}' 2>/dev/null | sed 's/^/  /'
    # A ativação usa --pull never: toda imagem da pilha tem que estar baixada.
    local i falta=0
    for i in $(dc --profile ativa config --images 2>/dev/null | sort -u); do
        docker image inspect "$i" >/dev/null 2>&1 || { echo "IMAGEM FALTANDO: $i"; falta=1; }
    done
    [ $falta = 0 ] && echo "imagens da pilha ativa: todas presentes"
    return 0
}

cmd_ativa() {
    local motivo=${1:-manual} i
    case "$(estado)" in ativa) log "a reserva já está ativa"; return 0 ;; esac
    mkdir -p "$EST"; exec 9>"$EST/trava"
    flock -n 9 || { log "outra operação em andamento"; return 1; }
    poe_estado ativando
    alerta "ATIVANDO a reserva na VPS (motivo: $motivo)"

    # 1. Postgres: sai de réplica. A partir daqui a réplica precisa ser refeita.
    if [ "$(psql_r 'select pg_is_in_recovery()')" = t ]; then
        [ "$(psql_r 'select pg_promote(true, 60)')" = t ] || { poe_estado falhou; alerta "FALHA: pg_promote"; return 1; }
        log "Postgres promovido"
    fi

    # 2. Contabilidade gravada aqui fica numa faixa de ids própria (reenvio na volta).
    sql radius -e "ALTER TABLE radacct AUTO_INCREMENT=$ID_ACCT; ALTER TABLE radpostauth AUTO_INCREMENT=$ID_ACCT;" 2>/dev/null || true

    # 3. Pilha de atendimento, FreeRADIUS nas portas reais.
    RESERVA_FR_PORTA_AUTH=1812 RESERVA_FR_PORTA_ACCT=1813 \
        dc --profile ativa up -d --no-deps --pull never $ATENDIMENTO >/dev/null 2>&1 \
        || { poe_estado falhou; alerta "FALHA: docker compose up da pilha"; return 1; }

    # 4. Esperar o authentik (até 5 min) e o FreeRADIUS local.
    for i in $(seq 60); do
        [ "$(docker inspect -f '{{.State.Health.Status}}' "$P-authentik-server-1" 2>/dev/null)" = healthy ] && break
        sleep 5
    done
    for i in $(seq 24); do local_responde && break; sleep 5; done
    local_responde || { poe_estado falhou; alerta "FALHA: FreeRADIUS da reserva não responde; .196 NÃO assumido"; return 1; }

    # 5. Teste da cadeia FreeRADIUS -> outpost -> authentik: usuário inexistente
    #    tem que voltar Reject COM origem=authentik no log.
    for i in $(seq 12); do
        SONDA_SEGREDO="$(env_v FR_SEGREDO_LOCAL)" "$SONDA" 127.0.0.1 1812 auth sonda-reserva-inexistente x >/dev/null 2>&1
        docker logs --since 30s "$P-freeradius-1" 2>&1 | grep 'usuario=sonda-reserva-inexistente' | grep -q 'origem=authentik' && break
        sleep 10
    done
    docker logs --since 30s "$P-freeradius-1" 2>&1 | grep 'usuario=sonda-reserva-inexistente' | grep -q 'origem=authentik' \
        || { poe_estado falhou; alerta "FALHA: outpost/authentik da reserva não respondem; .196 NÃO assumido"; return 1; }

    # 6. SSO pela reserva (administração congelada) e só então o anúncio.
    caddy_destino reserva || log "aviso: sso. continua apontando para a VM"
    radius0_sobe
    log "radius0 com $IP: anúncio por BGP"

    # 7. LDAP e TACACS+ (portas presas ao .196, por isso depois da radius0).
    dc --profile ativa up -d --no-deps --pull never reserva-ldap-outpost >/dev/null 2>&1 || alerta "aviso: LDAP da reserva não subiu"
    dc --profile ativa up -d --no-deps --pull never reserva-tacacs >/dev/null 2>&1 || alerta "aviso: TACACS+ da reserva não subiu"

    poe_estado ativa
    alerta "RESERVA ATIVA: a VPS atende o $IP. NÃO altere nada no authentik até a volta. Volta: provedor-reserva volta"
}

cmd_volta() {
    local forcar=${1:-} arq
    case "$(estado)" in espera) log "a reserva não está ativa"; return 0 ;; esac
    if [ "$forcar" != --forcar ] && ! vm_responde; then
        log "a VM não responde RADIUS em $VM; volta cancelada (use --forcar para voltar mesmo assim)"; return 1
    fi
    mkdir -p "$EST"; exec 9>"$EST/trava"
    flock -n 9 || { log "outra operação em andamento"; return 1; }
    poe_estado voltando
    alerta "VOLTA da reserva: a VPS deixa de anunciar o $IP"

    # 1. Sai o anúncio (a VM já anuncia e ganha; isto só limpa a reserva).
    ip link del radius0 2>/dev/null || true
    caddy_destino vm || log "aviso: confira o Caddy (sso-destino.caddy)"

    # 2. Contabilidade e pós-autenticação gravadas na reserva -> arquivo para a VM.
    arq="$EST/contabilidade-$(date +%Y%m%d-%H%M).sql"
    docker exec "$P-mariadb-1" sh -c 'exec mariadb-dump -uroot -p"$MARIADB_ROOT_PASSWORD" --no-create-info --replace --skip-triggers --where="radacctid >= '$ID_ACCT'" radius radacct' > "$arq.radacct" 2>/dev/null
    docker exec "$P-mariadb-1" sh -c 'exec mariadb-dump -uroot -p"$MARIADB_ROOT_PASSWORD" --no-create-info --replace --skip-triggers --where="id >= '$ID_ACCT'" radius radpostauth' > "$arq.radpostauth" 2>/dev/null
    cat "$arq.radacct" "$arq.radpostauth" > "$arq" && rm -f "$arq.radacct" "$arq.radpostauth"
    if tail -n 2 "$arq" | grep -q 'Dump completed'; then
        sql radius -e "DELETE FROM radacct WHERE radacctid >= $ID_ACCT; DELETE FROM radpostauth WHERE id >= $ID_ACCT;"
        log "contabilidade da reserva em $arq ($(grep -c '^REPLACE' "$arq") blocos). Na VM: provedor-traz-contabilidade"
    else
        log "aviso: dump da contabilidade incompleto ($arq); nada apagado na reserva"
    fi

    # 3. Pilha de atendimento fora.
    dc --profile ativa stop $ATENDIMENTO reserva-ldap-outpost reserva-tacacs >/dev/null 2>&1
    dc --profile ativa rm -f $ATENDIMENTO reserva-ldap-outpost reserva-tacacs >/dev/null 2>&1

    # 4. Réplica do zero (o banco promovido é descartado).
    refaz_replica || { poe_estado espera-sem-replica; alerta "VOLTA feita, mas a réplica do Postgres NÃO foi refeita: ver README (Refazer do zero)"; return 1; }
    poe_estado espera
    alerta "VOLTA concluída: VM atende o $IP; réplica refeita"
}

refaz_replica() {
    local i
    dc stop reserva-postgres >/dev/null 2>&1; dc rm -f reserva-postgres >/dev/null 2>&1
    docker volume rm "provedor-reserva_pg-reserva" >/dev/null 2>&1
    PG_REPLICA_PASS="$(env_v PG_REPLICA_PASS)" dc run --rm --no-deps -T -e PG_REPLICA_PASS --entrypoint sh reserva-postgres -c \
        'test -z "$(ls -A $PGDATA)" && PGPASSWORD="$PG_REPLICA_PASS" pg_basebackup -h 172.16.7.10 -U replicador -D $PGDATA -R -S vps_reserva -X stream -c fast --max-rate=10M && chown -R postgres:postgres $PGDATA && chmod 700 $PGDATA' \
        >/dev/null 2>&1 || return 1
    dc up -d reserva-postgres >/dev/null 2>&1 || return 1
    for i in $(seq 24); do
        [ "$(psql_r 'select status from pg_stat_wal_receiver' 2>/dev/null)" = streaming ] && { log "réplica em streaming"; return 0; }
        sleep 5
    done
    return 1
}

cmd_vigia() {
    local falha_desde="" avisou_auto=0 avisou_bgp=0 falhas_local=0 ok_local=0 vm_ok_desde="" avisou_volta=0 r agora e
    local rep_ok=1 rep_visto=0
    log "vigia iniciado (estado $(estado), automático $([ -e "$AUTO" ] && echo ligado || echo desligado), espera ${ESPERA}s)"
    # Depois de um reboot da VPS com a reserva ativa: a radius0 não existe.
    if [ "$(estado)" = ativa ] && [ ! -e /sys/class/net/radius0 ]; then
        log "reserva ativa sem radius0 (reboot?): sobe quando o FreeRADIUS local responder"
    fi
    while sleep 15; do
        agora=$(date +%s); e=$(estado)
        # réplica a cada 5 min (só em espera: na ativa o banco está promovido)
        if [ "$e" = espera ] && [ $((agora - rep_visto)) -ge 300 ]; then
            rep_visto=$agora
            if [ "$(psql_r 'select status from pg_stat_wal_receiver' 2>/dev/null)" = streaming ]; then
                [ $rep_ok = 0 ] && log "réplica do Postgres de volta em streaming"; rep_ok=1
            else
                [ $rep_ok = 1 ] && alerta "réplica do Postgres FORA de streaming"; rep_ok=0
            fi
        fi
        case "$e" in
        espera)
            vm_responde; r=$?
            if [ $r -eq 0 ]; then
                [ -n "$falha_desde" ] && log "VM voltou a responder (ficou $((agora - falha_desde))s sem)"
                falha_desde=""; avisou_auto=0; avisou_bgp=0
                if [ $rep_ok = 1 ]; then zbx 0 "normal: VM responde"; else zbx 7 "VM responde; réplica fora de streaming"; fi
            elif [ $r -eq 2 ]; then
                zbx 7 "sem o segredo da VM na cópia da tabela nas"
                log "aviso: sem o segredo da VM na cópia da tabela nas; sonda não feita"
            else
                [ -z "$falha_desde" ] && { falha_desde=$agora; log "VM não responde RADIUS; contando ${ESPERA}s"; }
                zbx 1 "VM sem resposta RADIUS há $((agora - falha_desde))s (ativa com ${ESPERA}s)"
                if [ $((agora - falha_desde)) -ge "$ESPERA" ]; then
                    if [ "$(bgp_sessoes)" -eq 0 ]; then
                        zbx 8 "VM sem resposta há $((agora - falha_desde))s e VPS sem BGP: não ativa"
                        [ $avisou_bgp -eq 0 ] && alerta "VM sem resposta há $((agora - falha_desde))s, mas a VPS está sem BGP: NÃO ativa"
                        avisou_bgp=1
                    elif [ -e "$AUTO" ]; then
                        # subshell: a trava (fd 9) é solta quando a ativação termina
                        ( cmd_ativa "VM sem resposta RADIUS há $((agora - falha_desde))s" )
                        falha_desde=""
                    else
                        zbx 8 "VM sem resposta há $((agora - falha_desde))s; automático desligado: rodar provedor-reserva ativa"
                        [ $avisou_auto -eq 0 ] && alerta "VM sem resposta há $((agora - falha_desde))s; automático DESLIGADO: rodar 'provedor-reserva ativa'"
                        avisou_auto=1
                    fi
                fi
            fi ;;
        ativa)
            if local_responde; then
                falhas_local=0; ok_local=$((ok_local + 1))
                if [ ! -e /sys/class/net/radius0 ] || ! ip link show radius0 | grep -q ',UP'; then
                    [ $ok_local -ge 4 ] && { radius0_sobe; alerta "FreeRADIUS da reserva respondendo de novo: $IP reanunciado"; \
                        dc --profile ativa up -d --no-deps --pull never reserva-ldap-outpost reserva-tacacs >/dev/null 2>&1; }
                fi
            else
                ok_local=0; falhas_local=$((falhas_local + 1))
                if [ $falhas_local -eq 3 ] && [ -e /sys/class/net/radius0 ]; then
                    ip link set radius0 down
                    alerta "FreeRADIUS da reserva NÃO responde: anúncio do $IP retirado"
                fi
            fi
            if vm_responde; then
                [ -z "$vm_ok_desde" ] && vm_ok_desde=$agora
                if [ $((agora - vm_ok_desde)) -ge 600 ] && [ $avisou_volta -eq 0 ]; then
                    alerta "A VM responde RADIUS há 10 min: rodar 'provedor-reserva volta' (manual)"; avisou_volta=1
                fi
            else
                vm_ok_desde=""
            fi
            if [ $avisou_volta = 1 ]; then zbx 4 "reserva ativa; VM responde há 10 min: rodar provedor-reserva volta"
            elif [ -e /sys/class/net/radius0 ] && ip link show radius0 | grep -q ',UP'; then zbx 3 "RESERVA ATIVA: VPS atende o $IP"
            else zbx 5 "reserva ativa SEM anúncio: FreeRADIUS da VPS não responde"; fi ;;
        ativando) zbx 2 "ativando a reserva" ;;
        falhou)   zbx 5 "ativação FALHOU: ver journalctl -t provedor-reserva" ;;
        *)        zbx 6 "$e" ;;   # voltando, espera-sem-replica: só manual
        esac
    done
}

case "${1:-estado}" in
    estado) cmd_estado ;;
    ativa)  cmd_ativa manual ;;
    volta)  cmd_volta "${2:-}" ;;
    vigia)  cmd_vigia ;;
    *) echo "uso: $0 estado|ativa|volta [--forcar]|vigia" >&2; exit 2 ;;
esac
