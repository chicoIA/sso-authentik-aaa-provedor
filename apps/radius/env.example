# ---------- app radius ----------
# Segredo compartilhado FreeRADIUS <-> outpost. O app authentik precisa repassá-lo
# ao container worker (o blueprint lê com !Env) e o app freeradius usa o mesmo valor.
AUTHENTIK_RADIUS_SECRET=<gerar>
# Token do outpost "provedor-radius" (preenchido por script depois do blueprint aplicado).
AUTHENTIK_RADIUS_TOKEN=<token>
# Opcional: redes que podem falar com o outpost (padrão: pontes Docker + loopback).
#AUTHENTIK_RADIUS_CLIENT_NETWORKS=10.233.0.0/16,127.0.0.1/32
