# Variáveis do app backup (todas opcionais)
# Destino das cópias
BACKUP_DIR=/var/backups/provedor
# Dias de retenção
BACKUP_RETENCAO_DIAS=14
# sim = inclui radacct/radpostauth (pesado: 18 GB)
BACKUP_RADACCT=nao
# sim = inclui a tabela nas (contém segredos dos equipamentos; arquivo 600). Padrão: não copia
BACKUP_NAS=nao
