# ---------- app authentik (núcleo) ----------
AUTHENTIK_TAG=2026.8.3
# Se o ghcr.io estiver bloqueado, use o Docker Hub:
#AUTHENTIK_IMAGE=docker.io/authentik/server
PG_DB=authentik
PG_USER=authentik
PG_PASS=<gerar>
AUTHENTIK_SECRET_KEY=<gerar>
AUTHENTIK_ERROR_REPORTING__ENABLED=false
# Usuário inicial "akadmin" e token de API usado pelos scripts.
AUTHENTIK_BOOTSTRAP_PASSWORD=<gerar>
AUTHENTIK_BOOTSTRAP_TOKEN=<gerar>
AUTHENTIK_BOOTSTRAP_EMAIL=noc@exemplo.net.br
# Endereço pelo qual a equipe acessa o authentik.
AUTHENTIK_URL_EXTERNA=https://100.66.80.196:9443
# Portas no host (o Docker ignora o ufw: prenda a um IP se precisar).
COMPOSE_PORT_HTTP=9000
COMPOSE_PORT_HTTPS=9443
# Consumo (valores baixos por padrão)
#AUTHENTIK_WEB__WORKERS=1
#AUTHENTIK_WEB__THREADS=2
#AUTHENTIK_WORKER__PROCESSES=1
#AUTHENTIK_WORKER__THREADS=2
# Tokens dos outposts: preenchidos por apps/authentik/scripts/tokens_outpost.py --gravar
AUTHENTIK_RADIUS_TOKEN=<token>
AUTHENTIK_LDAP_TOKEN=<token>
