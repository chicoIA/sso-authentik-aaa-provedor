# ---------- app painel ----------
# Segredo do client OIDC "painel-tacacs" no authentik (o blueprint 05-painel.yaml lê
# esta mesma variável no container authentik-worker, que aplica os blueprints).
PAINEL_OIDC_SECRET=<gerar>
# Chave que assina o cookie de sessão do painel. Trocar derruba as sessões abertas.
PAINEL_SECRET_KEY=<gerar>
# URL pela qual os navegadores acessam o painel (vira o redirect do OIDC).
#PAINEL_URL_EXTERNA=http://100.66.80.196:9049
# O authentik usa certificado autoassinado no 9443: 0 = não verificar TLS (padrão), 1 = verificar.
#PAINEL_OIDC_VERIFICAR_TLS=0
# Dias de retenção dos eventos no SQLite do painel.
#PAINEL_RETENCAO_DIAS=365
# Endereço que o CONTAINER usa para falar com o authentik (troca do código e userinfo).
# Vazio = usa AUTHENTIK_URL_EXTERNA (IP do host). Alternativa: http://authentik-server:9000
#PAINEL_AUTHENTIK_INTERNO=
# Usa também AUTHENTIK_URL_EXTERNA (definida no app authentik) e TZ (padrão America/Sao_Paulo).
