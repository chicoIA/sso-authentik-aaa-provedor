#  Banco do daloRADIUS (MariaDB do sistema), pelo SOCKET Unix (/run/mysqld
#  montado no container): usuário radius@localhost.
#    - SEMPRE: leitura dos NAS da tabela "nas" (read_clients) -- só SELECT
#    - modo legado (CHAP/MS-CHAP): radcheck/radreply/radusergroup/radgroup* -- só SELECT
#    - FR_GRAVAR_SQL=sim (produção): radacct e radpostauth (veja sites-available/provedor)
sql {
	dialect = "mysql"
	driver = "rlm_sql_${dialect}"

	mysql {
		warnings = auto
	}

	#  "localhost" = socket Unix (/run/mysqld/mysqld.sock).
	server = "localhost"
	port = 3306
	login = $ENV{DALO_DB_USER}
	password = $ENV{DALO_DB_PASS}
	radius_db = $ENV{DALO_DB_NAME}

	acct_table1 = "radacct"
	acct_table2 = "radacct"
	postauth_table = "radpostauth"
	authcheck_table = "radcheck"
	groupcheck_table = "radgroupcheck"
	authreply_table = "radreply"
	groupreply_table = "radgroupreply"
	usergroup_table = "radusergroup"
	read_groups = yes
	delete_stale_sessions = yes

	pool {
		start = 2
		min = 2
		max = 8
		spare = 3
		uses = 0
		retry_delay = 30
		lifetime = 0
		idle_timeout = 60
	}

	#  Cadastro NAS geral, como hoje: tabela "nas" (nasname em CIDR, inclusive
	#  0.0.0.0/0). Lida na subida do FreeRADIUS; nada é gravado nela.
	read_clients = yes
	client_table = "nas"

	group_attribute = "SQL-Group"

	#  Padrão do rlm_sql + "()": o radpostauth grava pass = "(authentik)" / "(legado)"
	#  em vez da senha (sem isso os parênteses viram =28 / =29).
	safe_characters = "@abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789.-_: /()"

	$INCLUDE ${modconfdir}/${.:name}/main/${dialect}/queries.conf
}
