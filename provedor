cmd=${1:-ajuda}; [ $# -gt 0 ] && shift
case "$cmd" in
    preparar) cmd_preparar "$@" ;;
    exemplo)  gerar_env exemplo ;;
    up)       cmd_up "$@" ;;
    down)     cmd_down "$@" ;;
    restart)  cmd_restart "$@" ;;
    logs)     cmd_logs "$@" ;;
    ps)       cmd_ps "$@" ;;
    config)   cmd_config "$@" ;;
    teste)    cmd_teste "$@" ;;
    status)   cmd_status "$@" ;;
    migrar)   cmd_migrar "$@" ;;
    backup)   cmd_backup "$@" ;;
    virada)   cmd_virada "$@" ;;
    tokens)   cmd_tokens "$@" ;;
    ajuda|-h|--help|help) ajuda ;;
    *) ajuda >&2; exit 2 ;;
esac
